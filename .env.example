# Backend Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
# Generate a strong random string (min 32 characters) for production
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRE=7d

# MongoDB Configuration
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hospital

# Frontend URLs for CORS (comma-separated)
# Add all frontend URLs that should be able to access this API
# Production example:
# FRONTEND_URLS=https://your-vercel-project.vercel.app
# Optional alias (single value): FRONTEND_URL=https://your-vercel-project.vercel.app
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173,http://10.7.150.254:5173

# Optional: Email Configuration (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password

# Optional: File Upload Configuration
# MAX_FILE_SIZE=5242880
# UPLOAD_DIR=./uploads
